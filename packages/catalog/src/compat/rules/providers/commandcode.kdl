// Command Code Provider API deployment contract. Model capabilities and effort
// ladders follow command-code@1.44.0, as tracked by pi-commandcode-provider.
provider "commandcode" {
	supports-developer-role #false
	supports-store #false
	supports-reasoning-effort #true
	max-tokens-field "max_tokens"
	thinking-mode "effort"
	limits-patch {
		max-tokens 65536
	}
	class "anthropic" {
		thinking-mode "anthropic-adaptive"
		supports-eager-tool-input-streaming #false
		supports-long-cache-retention #false
	}
	models "claude-fable-5" "claude-fable-5-1" "claude-opus-4-7" "claude-opus-4-8" \
		"claude-opus-5" "claude-sonnet-4-6" "claude-sonnet-5" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	models "deepseek/deepseek-v4-flash" "deepseek/deepseek-v4-flash-vision-exp" \
		"deepseek/deepseek-v4-pro" "zai-org/GLM-5.2" {
		thinking-efforts "high" "max"
	}
	models "deepseek/deepseek-v4-flash-fast" "moonshotai/Kimi-K3" "z-ai/glm-5.3-flash" \
		"zai-org/GLM-5.3" {
		thinking-efforts "low" "high" "max"
	}
	models "google/gemini-3.1-flash-lite" "google/gemini-3.5-flash" \
		"google/gemini-3.5-flash-lite" "google/gemini-3.6-flash" "google/gemini-3.7-flash" \
		"google/gemini-3.8-flash" "gpt-5.4-mini" "xai/grok-4.5" {
		thinking-efforts "low" "medium" "high"
	}
	models "gpt-5.3-codex" "gpt-5.4" "gpt-5.5" "xai/grok-4.6" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	models "gpt-5.6-luna" "gpt-5.6-sol" "gpt-5.6-terra" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	models "meta/muse-spark-1.1" "meta/muse-spark-1.2" "meta/muse-spark-1.2-contributor" \
		"meta/muse-spark-1.3" "meta/muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	models "Qwen/Qwen3.8-27B" "Qwen/Qwen3.8-Flash" "Qwen/Qwen3.8-Max" "Qwen/Qwen3.8-Max-0902" {
		thinking-efforts "low" "medium" "xhigh"
	}
	models "sakana/fugu-ultra" {
		thinking-efforts "high" "xhigh"
	}
	models "tencent/hy4-preview" {
		thinking-efforts "low" "medium" "high"
	}
	models "Qwen/Qwen3.8-27B" {
		limits-patch {
			max-tokens 32768
		}
	}
	models "z-ai/glm-5.3-flash" {
		limits-patch {
			max-tokens 131072
		}
	}
}
